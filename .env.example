# このファイルを .env.local にコピーして値を設定してください（.env.local は Git に含めません）
# 値の場所: Supabase ダッシュボード > Project Settings > Data API / API Keys
# 末尾に /rest/v1 などを付けないこと
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key（sb_publishable_...）または anon key。secret / service_role キーは入れないこと
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# サーバー専用（探索などのゲーム処理で使う）。Project Settings > API Keys の secret key（または service_role key）
# NEXT_PUBLIC_ を付けないこと（ブラウザに公開されてしまう）
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
